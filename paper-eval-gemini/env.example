# Gemini through Vertex AI (this is what uses the Google Cloud trial credits)
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Models (same model for memory, answers and judge)
MODEL=gemini-2.5-flash-lite
JUDGE_MODEL=gemini-2.5-flash-lite
EMBED_MODEL=gemini-embedding-001
EMBED_DIMS=768

# Storage
QDRANT_COLLECTION=locomo_gem_kuzu
KUZU_DB=kuzu_db/locomo_mem0g.kuzu

# Stops Mem0's telemetry thread, the cause of the "never exits" hang
MEM0_TELEMETRY=False
